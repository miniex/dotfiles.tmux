# generated by install.sh
os.conf

# generated by install.sh / bin/theme.sh
theme.conf

# user-local OS overrides (kept out of git so personal tweaks don't conflict)
os/local.conf
os/*.local.conf

# user-local themes — picked up by the prefix T menu, never committed
themes/*.local.conf

# install.sh / manual backups
*.backup.*

# tmux verbose logs (tmux -vv)
tmux-client-*.log
tmux-out-*.log
tmux-server-*.log
